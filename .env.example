# Groq — LLM (required) — https://console.groq.com/
# Copy this file to .env and paste your key (never commit .env)
GROQ_API_KEY=gsk_your-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings — fastembed works locally with no extra key (default)
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# For Vercel production (recommended): use OpenAI embeddings to avoid cold-start model load
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
# EMBEDDING_MODEL=text-embedding-3-small

TOP_N_RESULTS=10
TOP_N_FOR_AGENT=5
